#!/usr/bin/env python3
"""
lab - pick a lab from your Ludus catalogue, tweak a few settings, and build it.

Run on the Ludus/Proxmox host as root:   lab
There's also a web version of this menu: see README.md.
Everything here is a thin layer over the `ludus` CLI, so anything you do in
this menu can also be done by hand with `ludus ...` commands.
"""

import os
import subprocess
import sys

for _candidate in (os.environ.get("LAB_LIB"),
                   os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"),
                   "/opt/ludus-homelab/lib"):
    if _candidate and os.path.isfile(os.path.join(_candidate, "labcore.py")):
        sys.path.insert(0, _candidate)
        break

try:
    import yaml
    import labcore as core
except ImportError as exc:  # pragma: no cover - setup.sh installs both
    sys.exit(f"Missing part of the launcher ({exc}). Re-run setup.sh.")

VERSION = core.VERSION
LUDUS = core.LUDUS


# --------------------------------------------------------------------------
# Terminal output and prompts
# --------------------------------------------------------------------------
_TTY = sys.stdout.isatty()


def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if _TTY else text


def bold(t): return _c("1", t)
def dim(t): return _c("2", t)
def green(t): return _c("32", t)
def yellow(t): return _c("33", t)
def red(t): return _c("31", t)
def cyan(t): return _c("36", t)


def info(msg): print(f"{cyan('›')} {msg}")
def ok(msg): print(f"{green('✓')} {msg}")
def warn(msg): print(f"{yellow('!')} {msg}")
def fail(msg): print(f"{red('✗')} {msg}")


def heading(title):
    print()
    print(bold(title))
    print(dim("─" * max(len(title), 40)))


def _input(prompt):
    try:
        return input(prompt)
    except EOFError:
        print()
        sys.exit(0)


def ask_text(question, default="", validate=None):
    while True:
        suffix = f" [{default}]" if default != "" else ""
        answer = _input(f"  {question}{dim(suffix)}: ").strip() or str(default)
        problem = validate(answer) if validate else None
        if not problem:
            return answer
        warn(problem)


def ask_yn(question, default=True):
    hint = "Y/n" if default else "y/N"
    while True:
        answer = _input(f"  {question} {dim('[' + hint + ']')}: ").strip().lower()
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False
        warn("Please answer y or n.")


def ask_int(question, default, low, high):
    def check(value):
        if not value.isdigit() or not low <= int(value) <= high:
            return f"Enter a number from {low} to {high}."
        return None
    return int(ask_text(question, str(default), check))


def ask_choice(question, options, default=1, allow_back=False):
    """options: list of labels (or (label, detail) tuples). Returns a 0-based index, or None for back."""
    print(f"  {question}")
    for i, opt in enumerate(options, 1):
        label, detail = opt if isinstance(opt, tuple) else (opt, "")
        print(f"    {bold(str(i))}) {label}" + (f"  {dim(detail)}" if detail else ""))
    if allow_back:
        print(f"    {bold('b')}) Back")
    while True:
        raw = _input(f"  Choose{dim(' [' + str(default) + ']') if default else ''}: ").strip().lower()
        if not raw and default:
            return default - 1
        if allow_back and raw in ("b", "back", "q"):
            return None
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return int(raw) - 1
        warn("Pick one of the numbers shown.")


def ask_multi(question, options):
    print(f"  {question}")
    for i, (label, detail) in enumerate(options, 1):
        print(f"    {bold(str(i))}) {label}")
        print(f"       {dim(detail)}")
    while True:
        raw = _input(f"  Pick any, e.g. 1,3,5 {dim('[none]')}: ").strip().lower()
        if raw in ("", "none", "n", "0"):
            return []
        parts = [p for p in raw.replace(",", " ").split() if p]
        if all(p.isdigit() and 1 <= int(p) <= len(options) for p in parts):
            return sorted({int(p) - 1 for p in parts})
        warn("Use the numbers shown, separated by commas.")


def pause():
    _input(dim("  Press Enter to continue..."))


def ludus_live(*args):
    """Run a ludus command with its output going straight to the terminal."""
    try:
        return subprocess.run([LUDUS, *args], env=core.ENV).returncode
    except KeyboardInterrupt:
        print()
        info("Stopped watching. Nothing was cancelled on the server.")
        return 0


def preflight():
    try:
        subprocess.run([LUDUS, "version"], capture_output=True, env=core.ENV, check=False)
    except FileNotFoundError:
        sys.exit("The `ludus` command was not found. Install Ludus first (see README.md).")
    try:
        core.check_connection()
    except core.LudusError as exc:
        sys.exit(str(exc))


# --------------------------------------------------------------------------
# Questions from an option schema
# --------------------------------------------------------------------------
TEMPLATE_STATE = {}


def refresh_template_state():
    TEMPLATE_STATE.clear()
    TEMPLATE_STATE.update(core.template_states())


def ask_field(field, answers):
    label, default, help_text = field["label"], field["default"], field.get("help")
    kind = field["type"]
    if kind == "text":
        check = core.VALIDATORS.get(field.get("validate"))
        return ask_text(label, default, check)
    if kind == "int":
        question = f"{label} ({help_text})" if help_text else label
        return ask_int(question, default, field["min"], field["max"])
    if kind == "bool":
        question = f"{label}? ({help_text})" if help_text else f"{label}?"
        return ask_yn(question, default)
    if kind == "select":
        choices = field["choices"]
        start = next((i for i, c in enumerate(choices) if c[0] == default), 0) + 1
        return choices[ask_choice(label, [(c[1], c[2]) for c in choices], default=start)][0]
    if kind == "template":
        catalog = core.OS_CATALOGS[field["catalog"]]
        names = [t for _, t in catalog]
        start = names.index(default) + 1 if default in names else 1
        pick = ask_choice(label, [(lab, core.STATE_NOTES.get(TEMPLATE_STATE.get(t), core.STATE_NOTES[None]))
                                  for lab, t in catalog], default=start)
        return catalog[pick][1]
    if kind == "apps":
        avail = core.apps_for_family(core.os_family(answers.get(field.get("os_field"), "")))
        if not avail:
            info("No pre-install apps for this operating system.")
            return []
        picks = ask_multi(f"{label} ({help_text})" if help_text else label,
                          [(a["name"], a["cat"]) for a in avail])
        return [avail[i]["key"] for i in picks]
    raise ValueError(f"unknown field type {kind}")


def ask_schema(schema):
    answers = {}
    for field in schema:
        if field.get("show_if") and not answers.get(field["show_if"]):
            answers[field["key"]] = field["default"]
            continue
        answers[field["key"]] = ask_field(field, answers)
    return core.validate_options(schema, answers)


# --------------------------------------------------------------------------
# Flows
# --------------------------------------------------------------------------
def check_templates(cfg):
    """Return True when every template the lab needs is built."""
    states = core.template_states()
    missing = core.missing_templates(cfg, states)
    if not missing:
        return True

    heading("Templates needed first")
    for name, state in missing:
        print(f"    {name}  {dim('(' + {'building': 'building now', 'not built': 'not built'}.get(state, 'not downloaded yet') + ')')}")
    if all(state == "building" for _, state in missing):
        info("They're already building. Come back when `Templates` in the main menu shows them as built.")
        return False
    print()
    info("Templates are built once from the official ISOs and then reused by every lab.")
    if any(name.startswith("win") for name, _ in missing):
        info("Windows templates can take an hour or more each.")
    if ask_yn("Download and build the missing templates now?", True):
        try:
            ok(core.start_template_builds([n for n, _ in missing], states))
        except core.LudusError as exc:
            fail(str(exc))
            unknown = [n for n, s in missing if s is None]
            if unknown:
                info(f"You can add them by hand with:  ludus source add ludus-source-bsl --templates {','.join(unknown)}")
            return False
        if ask_yn("Watch the build log? (Ctrl-C stops watching; the build carries on)", False):
            ludus_live("templates", "logs", "-f")
    return False


def ask_addons(base_cfg):
    heading("Security tooling and realism (optional)")
    na = core.addon_applicability(base_cfg)
    available = [a for a in core.ADDONS if not na.get(a["key"])]
    skipped = [f"{a['title']} ({na[a['key']]})" for a in core.ADDONS if na.get(a["key"])]
    if skipped:
        info("Not available for this lab: " + "; ".join(skipped))
    picks = ask_multi("Add any of these to the lab?",
                      [(a["title"], f"+{a['ram']} GB. {a['detail']}" if a["ram"] else a["detail"]) for a in available])
    keys = [available[i]["key"] for i in picks]
    dfir_template = None
    if "dfir" in keys:
        dfir_template = ask_field(core.DFIR_FIELD, {})
    return keys, dfir_template


def print_plan(cfg, range_id, addons=()):
    heading("What will be built")
    rows = []
    for vm in core.vms(cfg):
        d = core.describe_vm(vm, range_id)
        rows.append((d["name"], str(d["template"]).replace("-template", ""), f"10.x.{d['vlan']}.{d['octet']}",
                     core.fmt_gb(d["ram"] or 0), str(d["cpus"] or "")))
    rows.append((f"{range_id}-router", "(automatic)", "10.x.<vlan>.254", core.fmt_gb(core.router_ram(cfg)), "2"))
    header = ("VM", "Template", "IP", "RAM", "CPU")
    widths = [max(len(r[i]) for r in rows + [header]) for i in range(5)]
    print("    " + "  ".join(h.ljust(w) for h, w in zip(header, widths)))
    for row in rows:
        print("    " + "  ".join(c.ljust(w) for c, w in zip(row, widths)))
    domains = sorted({(vm.get("domain") or {}).get("fqdn") for vm in core.vms(cfg) if vm.get("domain")})
    print()
    if domains:
        print(f"    Domain(s): {', '.join(domains)}")
    if addons:
        print(f"    Add-ons:   {', '.join(addons)}")
    print(f"    Timezone:  {(cfg.get('defaults') or {}).get('timezone', 'server default')}")
    need = core.total_ram(cfg)
    total, avail = core.host_memory_gb()
    line = f"    RAM:       {core.fmt_gb(need)} GB"
    if total:
        line += dim(f"   (host has {total:.0f} GB, {avail:.0f} GB free right now)")
    print(line)
    if avail and need > avail - 2:
        heavy = any(core.is_windows(v) or core.is_kali(v) or core.is_tool(v) for v in core.vms(cfg))
        warn("That's more than the host has free right now. Power off other labs first"
             + (" or pick the Lean profile." if heavy else "."))
    est = core.build_time_estimate(cfg, TEMPLATE_STATE)
    parts = []
    if est["templates_min"]:
        parts.append(f"{core.fmt_duration(est['templates_min'])} building templates")
    parts.append(f"{core.fmt_duration(est['deploy_min'])} to deploy")
    print(f"    Est. time: ~{core.fmt_duration(est['total_min'])}  " + dim(f"({', '.join(parts)})"))
    print(dim("    x = this lab's range number, assigned when it's created."))


def launch_lab():
    try:
        blueprints = core.ludus_json("blueprint", "list")
    except core.LudusError as exc:
        fail(f"Couldn't list blueprints: {exc}")
        return
    if not blueprints:
        warn("No blueprints found. Run setup.sh to install the catalogue.")
        return

    entries = sorted((core.lab_info(bp) for bp in blueprints), key=lambda e: (not e["known"], e["title"].lower()))
    heading("Launch a lab")
    pick = ask_choice("Which lab?", [(e["title"], e["blurb"]) for e in entries], allow_back=True)
    if pick is None:
        return
    entry = entries[pick]
    blueprint_id = entry["blueprint"]

    try:
        raw = core.ludus_json("blueprint", "config", "get", blueprint_id)
        base_cfg = core.load_yaml(raw.get("result", "") if isinstance(raw, dict) else "")
    except (core.LudusError, yaml.YAMLError) as exc:
        fail(f"Couldn't read the blueprint config: {exc}")
        return
    if not core.vms(base_cfg):
        fail("That blueprint has no VMs in it.")
        return

    if not check_templates(base_cfg):
        return
    refresh_template_state()

    heading(f"Settings - {entry['title']}")
    options = ask_schema(core.lab_schema(blueprint_id, base_cfg))
    addons, dfir_template = ask_addons(base_cfg)

    cfg, details = core.build_lab_config(blueprint_id, base_cfg, options, addons, dfir_template)
    profile = "standard"
    if details["ram_lean"] is not None:
        pick = ask_choice("RAM profile", [
            ("Standard", f"~{core.fmt_gb(details['ram_standard'])} GB, as the lab was designed"),
            ("Lean", f"~{core.fmt_gb(details['ram_lean'])} GB, Windows VMs get 4 GB and tool servers 2 GB less - slower"),
        ])
        profile = ["standard", "lean"][pick]
    cfg, details = core.build_lab_config(blueprint_id, base_cfg, options, addons, dfir_template, profile)
    for note in details["notes"]:
        warn(note)
    if details["tools_vlan"]:
        info(f"Security tools go on VLAN {details['tools_vlan']} (10.x.{details['tools_vlan']}.0/24).")

    # The settings can switch templates (e.g. Debian 12 instead of 13), so check again.
    if not check_templates(cfg):
        return

    absent = core.missing_roles(cfg)
    if absent:
        warn("These roles aren't installed on the Ludus server: " + ", ".join(absent))
        info("Re-run setup.sh to install them. Ludus will refuse the config until they're there.")
        if not ask_yn("Continue anyway?", False):
            return

    existing = {r.get("rangeID") for r in core.list_ranges()}
    range_id = ask_text("Short ID for this lab (used in VM names)",
                        core.unique_range_id(entry["range_id"], existing),
                        lambda v: core.valid_range_id(v, existing))
    name = ask_text("Display name", entry["title"])

    print_plan(cfg, range_id, details["addons"])
    print()
    if not ask_yn("Build it now?", True):
        info("Nothing was created.")
        return

    try:
        core.launch(cfg, range_id, name, blueprint_id, details["ram_profile"], remove_on_reject=False)
    except core.LaunchError as exc:
        fail(str(exc))
        if exc.stage == "config":
            info(f"The config is saved at {exc.config_path} if you want to fix it by hand.")
            if ask_yn(f"Remove the empty range {range_id}?", True):
                try:
                    core.ludus("range", "rm-range", "-r", range_id, "--no-prompt", "--force")
                    ok("Removed.")
                except core.LudusError as err:
                    fail(str(err))
        return
    ok(f"Created range {range_id}.")
    ok("Configuration accepted.")
    ok("Build started. VMs are being cloned and configured now.")

    if details["addons"]:
        show_tool_logins(range_id, cfg)
    info("Small labs take 20-40 minutes; GOAD and labs with tooling can take a few hours.")
    info(f"You can close this and check later from 'Manage my labs', or with:  ludus range logs -f -r {range_id}")
    if ask_yn("Watch the build log now? (Ctrl-C stops watching; the build carries on)", True):
        ludus_live("range", "logs", "-f", "-r", range_id)


def show_tool_logins(rid, cfg=None):
    if cfg is None:
        try:
            cfg = core.load_lab_config(rid)
        except (core.LudusError, yaml.YAMLError) as exc:
            fail(f"Couldn't read the lab's config: {exc}")
            return
    try:
        number = core.ludus_json("range", "list", "-r", rid).get("rangeNumber", "x")
    except (core.LudusError, AttributeError):
        number = "x"
    logins = core.tool_logins(cfg, number)
    heading("Security tools in this lab")
    if not logins:
        info("This lab has no security tooling add-ons.")
        return
    for t in logins:
        url = t["url"].replace("rdp://", "RDP to ")
        extra = " - tools are in C:\\Tools" if t["label"] == "DFIR workstation" else ""
        print(f"    {t['label']:28} {url:32} {t['username']} / {t['password']}{extra}")
    print(dim("    Connect with WireGuard first (main menu > How to connect). Certificates are self-signed."))


def manage_labs():
    while True:
        ranges = core.list_ranges()
        heading("My labs")
        if not ranges:
            info("No labs yet. Launch one from the main menu.")
            return
        options = []
        for r in ranges:
            vm_count = r.get("numberOfVMs", len(r.get("VMs") or []))
            state = r.get("rangeState") or "NEVER DEPLOYED"
            testing = "  testing mode" if r.get("testingEnabled") else ""
            options.append((f"{r.get('rangeID')}  {r.get('name', '')}",
                            f"10.{r.get('rangeNumber')}.0.0/16  {vm_count} VMs  {state}{testing}"))
        pick = ask_choice("Which lab?", options, allow_back=True)
        if pick is None:
            return
        manage_one(ranges[pick])


def manage_one(rng):
    rid = rng.get("rangeID")
    actions = [
        ("Show VMs and status", lambda: ludus_live("range", "list", "-r", rid)),
        ("Show security tool logins", lambda: show_tool_logins(rid)),
        ("Watch the build log", lambda: ludus_live("range", "logs", "-f", "-r", rid)),
        ("Show errors from the last build", lambda: ludus_live("range", "errors", "-r", rid)),
        ("Power on all VMs", lambda: run_step("Powering on", "power", "on", "-n", "all", "-r", rid)),
        ("Power off all VMs", lambda: run_step("Powering off", "power", "off", "-n", "all", "-r", rid)),
        ("Take a snapshot of every VM", lambda: snapshot_create(rid)),
        ("Roll back to a snapshot", lambda: snapshot_revert(rid)),
        ("Testing mode on (snapshot + cut Windows off the internet)",
         lambda: run_step("Starting testing mode", "testing", "start", "-r", rid)),
        ("Testing mode off (roll back to the testing snapshot)",
         lambda: run_step("Stopping testing mode", "testing", "stop", "-r", rid)),
        ("Re-run the build (re-applies the config)", lambda: run_step("Redeploying", "range", "deploy", "-r", rid)),
        ("Save RDP files for the Windows VMs", lambda: save_rdp(rid)),
        ("Delete this lab", lambda: destroy(rid)),
    ]
    while True:
        heading(f"Lab {rid}")
        pick = ask_choice("What do you want to do?", [a[0] for a in actions], default=1, allow_back=True)
        if pick is None:
            return
        result = actions[pick][1]()
        if result == "deleted":
            return
        pause()


def run_step(label, *args):
    info(f"{label}...")
    try:
        ok(core.result_message(core.run(args)))
    except core.LudusError as exc:
        fail(str(exc))


def snapshot_create(rid):
    name = ask_text("Snapshot name", "clean", core.valid_snapshot_name)
    desc = ask_text("Description", "Saved from the lab launcher")
    run_step("Taking snapshots (this can take a minute)", "snapshots", "create", name, "-d", desc, "-r", rid)


def snapshot_revert(rid):
    ludus_live("snapshots", "list", "-r", rid)
    name = ask_text("Snapshot name to roll back to (blank to cancel)", "")
    if name and ask_yn(f"Roll every VM in {rid} back to '{name}'? Changes since then are lost.", False):
        run_step("Rolling back", "snapshots", "revert", name, "-r", rid)


def save_rdp(rid):
    path = os.path.join(os.path.expanduser("~"), f"{rid}-rdp.zip")
    run_step("Downloading RDP files", "range", "rdp", "-r", rid, "-o", path)
    info(f"Copy it to your computer with:  scp root@<proxmox-ip>:{path} .")


def destroy(rid):
    warn(f"This deletes every VM in {rid} and the range itself. It can't be undone.")
    typed = ask_text(f"Type {rid} to confirm (blank to cancel)", "")
    if typed != rid:
        info("Cancelled.")
        return None
    try:
        core.ludus("range", "rm-range", "-r", rid, "--no-prompt", "--force")
        ok(f"{rid} is being deleted.")
        return "deleted"
    except core.LudusError as exc:
        fail(str(exc))
        return None


def templates_menu():
    while True:
        heading("Templates")
        ludus_live("templates", "list")
        pick = ask_choice("Templates", ["Build everything that isn't built yet",
                                        "Watch the template build log",
                                        "Show build status"], allow_back=True)
        if pick is None:
            return
        if pick == 0:
            run_step("Starting template builds", "templates", "build")
        elif pick == 1:
            ludus_live("templates", "logs", "-f")
        else:
            ludus_live("templates", "status")
        pause()


def connect_info():
    heading("Connecting to your labs")
    path = os.path.join(os.path.expanduser("~"), "ludus-wireguard.conf")
    try:
        conf = core.ludus("user", "wireguard")
        with open(path, "w") as fh:
            fh.write(conf)
        os.chmod(path, 0o600)
        ok(f"WireGuard config saved to {path}")
    except (core.LudusError, OSError) as exc:
        fail(f"Couldn't fetch the WireGuard config: {exc}")
    print(f"""
  1. Copy it to your computer:   scp root@<proxmox-ip>:{path} .
  2. Import it into the WireGuard app and connect. You can then reach every
     lab VM directly by IP (10.<range number>.<vlan>.<octet>).
  3. Windows VMs: RDP on port 3389.  Linux VMs: SSH on port 22.
     Kali desktop in a browser: https://<kali ip>:8444

  Default logins (lab-only passwords):
    Windows local admin   localuser / password
    Domain admin          <DOMAIN>\\domainadmin / password
    Domain user           <DOMAIN>\\domainuser / password
    Debian                debian / debian
    Kali                  kali / kali   (browser desktop: kali / password)

  Security tools (Kibana, Wazuh, Velociraptor, DFIR workstation):
    Manage my labs > pick the lab > Show security tool logins

  Prefer a browser? The web version of this menu is at https://<proxmox-ip>:8443
""")


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-V", "--version"):
        print(f"lab {VERSION}")
        return
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return
    preflight()
    menu = [
        ("Launch a new lab", launch_lab),
        ("Manage my labs", manage_labs),
        ("Templates", templates_menu),
        ("How to connect", connect_info),
    ]
    try:
        while True:
            heading(f"Ludus lab launcher {dim('v' + VERSION)}")
            pick = ask_choice("Main menu", [m[0] for m in menu] + ["Quit"], default=1)
            if pick == len(menu):
                return
            menu[pick][1]()
    except KeyboardInterrupt:
        print()


if __name__ == "__main__":
    main()
